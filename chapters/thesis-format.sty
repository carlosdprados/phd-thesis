%% ============================================================
%%  thesis-format.sty
%%
%%  Shared formatting layer for the PhD thesis, implementing the
%%  Universitat de València recommendations for doctoral theses.
%%
%%  Usage (from any chapter file):
%%      \documentclass[12pt, twoside]{report}
%%      \usepackage{thesis-format}
%%      \addbibresource{../bibliography/references.bib}
%%
%%  Chapter-specific content (extra packages such as chemfig,
%%  custom \newcommand shortcuts, \DeclareSIUnit, etc.) should
%%  remain in the individual chapter files.
%%
%%  University recommendations captured here:
%%      * Page trim      : 17 cm x 24 cm
%%      * Line spacing   : 1.5 on body text
%%      * Printing       : double-sided (twoside at class level)
%%      * Font size      : 12 pt (set at class level)
%%
%%  Font-size rationale: 12 pt Computer Modern at 1.5 spacing on
%%  the 17 x 24 cm trim yields roughly 65-70 characters per line
%%  with the margins below, which is within the 60-75 range
%%  generally recommended for comfortable reading. 11 pt would
%%  also be defensible but would compress the text block beyond
%%  what the UV examples we inspected use. 12 pt is therefore
%%  retained as the default across all chapters.
%% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis-format}[2026/04/15 v1.0 PhD thesis shared formatting]

%% --- Fonts and encoding ---
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}

%% --- Languages ---
%%  English is the main language; Spanish and Catalan are loaded only so the
%%  Resumen / Resum front-matter pages hyphenate correctly. shorthands=off
%%  disables babel's active-character shortcuts (".", "~", "<", ">") so the
%%  Spanish module cannot clash with siunitx/amsmath in the body. Loaded
%%  before hyperref, as babel requires.
\RequirePackage[shorthands=off, main=english, spanish, catalan]{babel}

%% --- Page geometry ---
%%  Trim: 17 cm wide x 24 cm tall, per UV recommendations.
%%  Margins: asymmetric to accommodate a bound, double-sided
%%  thesis. The inner margin is enlarged to leave room for the
%%  binding gutter; the outer margin is correspondingly reduced.
%%  Assumptions (documented here so they are easy to revisit):
%%      * Binding takes ~0.5-0.8 cm of the inner edge at print.
%%      * A 2.2 cm inner margin leaves ~1.5 cm of visible inner
%%        white space after binding.
%%      * Top / bottom margins include a single-line header that
%%        carries chapter / section marks via fancyhdr.
\RequirePackage[
  paperwidth  = 17cm,
  paperheight = 24cm,
  inner       = 2.2cm,
  outer       = 1.8cm,
  top         = 2.2cm,
  bottom      = 2.2cm,
  headheight  = 28pt,   % enlarged so fancyhdr fits under onehalfspacing
  headsep     = 10pt
]{geometry}

%% --- Line spacing ---
%%  setspace is used rather than \baselinestretch so that the
%%  spacing is also propagated correctly inside amsmath
%%  environments and floats. \onehalfspacing is exactly the
%%  1.5 line spacing the UV guidelines ask for.
\RequirePackage{setspace}
\onehalfspacing

%% --- Mathematics ---
\RequirePackage{amsmath, amssymb, amsthm}
\RequirePackage{bm}
\RequirePackage{siunitx}
\sisetup{
  separate-uncertainty = true,
  range-phrase         = \text{--},
  detect-all
}
\DeclareSIUnit{\angstrom}{\text{\AA}}

%% --- Chemistry ---
\RequirePackage[version=4]{mhchem}

%% --- Figures and tables ---
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{placeins}  % \FloatBarrier, to keep floats near their reference
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{rotating}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small, labelfont=bf, width=0.9\linewidth}

%% --- Float-placement parameters ---
%%  Relaxed so that moderately tall figures share their page
%%  with surrounding text instead of being promoted onto
%%  dedicated float pages. Needed because 1.5 line spacing
%%  makes text blocks taller and would otherwise trip the
%%  default \topfraction=0.7 threshold.
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.7}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.85}

%% --- Colours ---
\RequirePackage[dvipsnames]{xcolor}

%% --- References and links ---
\RequirePackage[
  backend  = biber,
  style    = nature,
  sorting  = none,
  maxnames = 6,
  minnames = 3,
  doi      = true,
  url      = false
]{biblatex}
\AtBeginBibliography{\raggedright\sloppy}

\RequirePackage[hidelinks, colorlinks=false]{hyperref}
\RequirePackage{cleveref}

%% Standalone chapter PDFs still cite material in the other chapters and
%% appendices. Import the labels written by a bound-thesis build so those
%% public PDFs contain resolved chapter, section, figure, and table numbers.
%% The Makefile builds the thesis first and keeps standalone auxiliary files
%% in a separate directory, preventing either build from overwriting the
%% other's label database.
\ifdefined\thesismode\else
  \RequirePackage{xr-hyper}
  \providecommand{\standaloneauxname}{}
  \newcommand{\importthesislabels}[1]{%
    \def\thesislabelsource{#1}%
    \ifx\standaloneauxname\thesislabelsource\else
      %% Keep the embedded target relative to the peer PDF, so links remain
      %% valid after the chapter snapshots are copied into exports/.
      \externaldocument{../build/chapters/#1}[#1.pdf]%
    \fi
  }
  \importthesislabels{frontmatter_motivation}
  \importthesislabels{chapter1_introduction}
  \importthesislabels{chapter2_proof_of_concept}
  \importthesislabels{chapter3_bridge}
  \importthesislabels{chapter4_comparative}
  \importthesislabels{chapter5_temporal}
  \importthesislabels{chapter6_conclusions}
  %% Appendices are distributed within the bound thesis rather than as
  %% separate snapshots, so their links target the exported thesis PDF.
  \externaldocument{../build/chapters/appendix_chapter2_supporting_information}[thesis.pdf]
  \externaldocument{../build/chapters/appendix_chapter3_bridge_SI}[thesis.pdf]
  \externaldocument{../build/chapters/appendix_chapter4_comparative_SI}[thesis.pdf]
  \externaldocument{../build/chapters/appendix_chapter5_temporal_SI}[thesis.pdf]
  %% rotating creates private RF<n> labels whose names restart in each
  %% standalone document. They are never cited, so discard imported copies
  %% before the current document reads or creates its own rotation labels.
  \makeatletter
  \@for\thesis@rotlabel:=RF1,RF2,RF3,RF4,RF5,RF6,RF7,RF8,RF9,RF10,RF11,RF12\do{%
    \global\expandafter\let\csname r@\thesis@rotlabel\endcsname\@undefined
  }
  \makeatother
\fi

%% --- Headers and footers ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\leftmark}
\fancyhead[RO]{\small\rightmark}
\fancyfoot[C]{\small\thepage}

%% --- Paragraph spacing ---
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

\endinput
